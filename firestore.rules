rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "yasaspalliyaguruge@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    // Admin = the verified bootstrap owner email OR any user manually set to role:admin
    function isAdmin() {
      return isBootstrapAdmin() || (
        isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'client') == 'admin'
      );
    }

    // ── Users ────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Create: user creates their own doc with role:client, OR admin creates any
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.get('role', 'client') == 'client') ||
        isAdmin()
      );

      // Update: user can update their own doc but NOT change role or createdAt
      allow update: if isAuthenticated() && (
        (isOwner(userId) &&
          request.resource.data.get('role', 'client') == resource.data.get('role', 'client') &&
          request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        ) ||
        isAdmin()
      );
    }

    // ── Availability ─────────────────────────────────────────────────────────
    match /availability/{dateString} {
      // Anyone (even unauthenticated) can read to see available slots on calendar
      allow read: if true;

      // Only admin can create/delete availability documents
      allow create, delete: if isAdmin();

      // Admin can do anything; authenticated users can only change the slots field.
      // This keeps booking/reschedule flows working even when admin metadata fields
      // like blocked or blockedReason exist on the document.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.slots is list &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots']) &&
        request.resource.data.get('blocked', resource.data.get('blocked', null)) == resource.data.get('blocked', null) &&
        request.resource.data.get('blockedReason', resource.data.get('blockedReason', null)) == resource.data.get('blockedReason', null)
      );
    }

    // ── Appointments ─────────────────────────────────────────────────────────
    match /appointments/{appointmentId} {
      // Client reads their own; admin reads all
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || isAdmin()
      );

      // Any logged-in user can create an appointment for themselves; admins can create for any client
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'clientId',
          'clientName',
          'date',
          'timeSlot',
          'serviceType',
          'status',
          'notes'
        ]) &&
        request.resource.data.clientName is string &&
        request.resource.data.status == 'scheduled' &&
        request.resource.data.date is string &&
        request.resource.data.timeSlot is string &&
        request.resource.data.serviceType is string &&
        request.resource.data.notes is string &&
        (
          request.resource.data.clientId == request.auth.uid ||
          isAdmin()
        );

      // Client can cancel or reschedule their own; admin can do anything
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.clientId == request.auth.uid &&
        resource.data.status == 'scheduled' && (
          // Cancel: only status changes to 'cancelled'
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
           request.resource.data.status == 'cancelled') ||
          // Reschedule: only date and timeSlot change
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'timeSlot'])
        )
      );

      allow delete: if isAdmin();
    }

    // ── Client Notes (admin only) ─────────────────────────────────────────────
    match /clientNotes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /mediaAssets/{assetId} {
      allow read, write, delete: if isAdmin();
    }

    // ── Practice Settings ─────────────────────────────────────────────────────
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Audit Logs ────────────────────────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // ── Mail Queue ────────────────────────────────────────────────────────────
    // Written OUTSIDE transactions now (addDoc), so just require auth.
    // The to: field doesn't need to match email — phone users have no email.
    match /mail/{mailId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['to', 'message']) &&
        request.resource.data.to is string &&
        request.resource.data.message.keys().hasOnly(['subject', 'html', 'text']) &&
        request.resource.data.message.subject is string &&
        request.resource.data.message.html is string &&
        request.resource.data.message.text is string;
      allow read, update, delete: if false;
    }
  }
}
