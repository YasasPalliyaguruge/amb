rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == "yasaspalliyaguruge@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isBootstrapAdmin() || (
        isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'client') == 'admin'
      );
    }

    function isShortString(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalShortString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function isHttpsUrl(value) {
      return value is string &&
        value.size() <= 2000 &&
        (
          value.size() == 0 ||
          value.matches('https://.*')
        );
    }

    function hasOnlyUserKeys(data) {
      return data.keys().hasOnly([
        'name',
        'email',
        'phone',
        'timezone',
        'role',
        'createdAt'
      ]);
    }

    function hasValidUserFields(data) {
      return hasOnlyUserKeys(data) &&
        isShortString(data.get('name', ''), 1, 120) &&
        isOptionalShortString(data.get('email', ''), 320) &&
        isOptionalShortString(data.get('phone', ''), 32) &&
        isOptionalShortString(data.get('timezone', ''), 80) &&
        (
          data.get('role', 'client') == 'client' ||
          data.get('role', 'client') == 'admin'
        );
    }

    function hasOnlyAvailabilityKeys(data) {
      return data.keys().hasOnly(['slots', 'blocked', 'blockedReason']);
    }

    function hasValidAvailabilitySlots(data) {
      return data.slots is list &&
        data.slots.size() <= 64;
    }

    function preservesAvailabilityMetadata() {
      return request.resource.data.get('blocked', resource.data.get('blocked', null)) == resource.data.get('blocked', null) &&
        request.resource.data.get('blockedReason', resource.data.get('blockedReason', null)) == resource.data.get('blockedReason', null);
    }

    function isSafeClientSlotMutation() {
      return isAuthenticated() &&
        hasOnlyAvailabilityKeys(resource.data) &&
        hasOnlyAvailabilityKeys(request.resource.data) &&
        hasValidAvailabilitySlots(request.resource.data) &&
        preservesAvailabilityMetadata() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['slots']) &&
        (
          request.resource.data.slots.size() == resource.data.slots.size() - 1 ||
          request.resource.data.slots.size() == resource.data.slots.size() ||
          request.resource.data.slots.size() == resource.data.slots.size() + 1
        );
    }

    function hasOnlyAppointmentKeys(data) {
      return data.keys().hasOnly([
        'clientId',
        'clientName',
        'clientEmail',
        'date',
        'timeSlot',
        'serviceType',
        'status',
        'notes',
        'sessionMode',
        'onlineSession'
      ]);
    }

    function hasValidOnlineSessionFields(data) {
      return data == null || (
        data is map &&
        data.keys().hasOnly([
          'provider',
          'url',
          'visibleToClient',
          'notes'
        ]) &&
        (
          data.provider == 'zoom' ||
          data.provider == 'teams' ||
          data.provider == 'google_meet' ||
          data.provider == 'jitsi' ||
          data.provider == 'other'
        ) &&
        isHttpsUrl(data.url) &&
        data.visibleToClient is bool &&
        isOptionalShortString(data.notes, 500)
      );
    }

    function hasValidAppointmentFields(data) {
      return hasOnlyAppointmentKeys(data) &&
        isShortString(data.clientId, 1, 128) &&
        isShortString(data.clientName, 1, 120) &&
        isOptionalShortString(data.get('clientEmail', ''), 320) &&
        isShortString(data.date, 8, 16) &&
        isShortString(data.timeSlot, 3, 16) &&
        isShortString(data.serviceType, 1, 120) &&
        (
          data.status == 'scheduled' ||
          data.status == 'completed' ||
          data.status == 'cancelled'
        ) &&
        data.notes is string &&
        data.notes.size() <= 1000 &&
        (
          data.get('sessionMode', 'in_person') == 'in_person' ||
          data.get('sessionMode', 'in_person') == 'online'
        ) &&
        hasValidOnlineSessionFields(data.get('onlineSession', null));
    }

    function preservesAppointmentIdentity() {
      return request.resource.data.clientId == resource.data.clientId &&
        request.resource.data.clientName == resource.data.clientName &&
        request.resource.data.get('clientEmail', '') == resource.data.get('clientEmail', '') &&
        request.resource.data.serviceType == resource.data.serviceType &&
        request.resource.data.notes == resource.data.notes &&
        request.resource.data.get('sessionMode', 'in_person') == resource.data.get('sessionMode', 'in_person') &&
        request.resource.data.get('onlineSession', null) == resource.data.get('onlineSession', null);
    }

    function isClientCancellation() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        preservesAppointmentIdentity() &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.timeSlot == resource.data.timeSlot &&
        request.resource.data.status == 'cancelled';
    }

    function isClientReschedule() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'timeSlot']) &&
        preservesAppointmentIdentity() &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.status == 'scheduled' &&
        isShortString(request.resource.data.date, 8, 16) &&
        isShortString(request.resource.data.timeSlot, 3, 16);
    }

    // Users
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isAuthenticated() && hasValidUserFields(request.resource.data) && (
        (isOwner(userId) &&
          request.resource.data.get('role', 'client') == 'client'
        ) ||
        isAdmin()
      );

      allow update: if isAuthenticated() && hasValidUserFields(request.resource.data) && (
        (isOwner(userId) &&
          request.resource.data.get('role', 'client') == resource.data.get('role', 'client') &&
          request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
        ) ||
        isAdmin()
      );
    }

    // Availability
    match /availability/{dateString} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isSafeClientSlotMutation();
    }

    // Appointments
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid || isAdmin()
      );

      allow create: if isAuthenticated() &&
        hasValidAppointmentFields(request.resource.data) &&
        request.resource.data.status == 'scheduled' &&
        (
          request.resource.data.clientId == request.auth.uid ||
          isAdmin()
        );

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.clientId == request.auth.uid &&
        resource.data.status == 'scheduled' &&
        hasValidAppointmentFields(request.resource.data) &&
        (
          isClientCancellation() ||
          isClientReschedule()
        )
      );

      allow delete: if isAdmin();
    }

    // Client Notes (admin only)
    match /clientNotes/{noteId} {
      allow read, write: if isAdmin();
    }

    match /mediaAssets/{assetId} {
      allow read, write, delete: if isAdmin();
    }

    // Practice Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Mail Queue
    match /mail/{mailId} {
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['to', 'message']) &&
        isOptionalShortString(request.resource.data.to, 320) &&
        request.resource.data.message.keys().hasOnly(['subject', 'html', 'text']) &&
        isShortString(request.resource.data.message.subject, 1, 160) &&
        isShortString(request.resource.data.message.html, 1, 20000) &&
        isShortString(request.resource.data.message.text, 1, 8000);
      allow read, update, delete: if false;
    }
  }
}
